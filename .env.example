# Local development. On Vercel, connecting Supabase (Storage → Supabase) sets POSTGRES_* for you.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres

# Optional: direct (non-pooled) URL for migrations. Vercel + Supabase: POSTGRES_URL_NON_POOLING.
# MIGRATION_DATABASE_URL=

# Optional: connections per server instance (default 3). Use 1 with the PGlite dev server.
# DATABASE_POOL_MAX=

# Optional: Supabase CA certificate (PEM) to verify TLS. Without it, TLS is encrypted but unverified.
# DATABASE_CA_CERT=

# Public origin for canonical URLs, sitemap, RSS and Open Graph. Vercel falls back to its production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables POST /api/revalidate (Authorization: Bearer <secret>), at least 16 characters.
# REVALIDATE_SECRET=

# Optional: extra image hosts for next/image, comma-separated (wildcards like *.example.com work).
# IMAGE_HOSTS=
